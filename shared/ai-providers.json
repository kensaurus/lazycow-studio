    "openrouter": {
      "name": "OpenRouter",
      "protocol": "openai_chat",
      "core": true,
      "keyEnv": "OPENROUTER_API_KEY_PARKED",
      "keyEnvAlso": ["OPENROUTER_API_KEY"],
      "keyPrefix": "sk-or-",
      "keyHint": "openrouter.ai/settings/keys (they start with sk-or-)",
      "dashboard": "https://openrouter.ai/settings/credits",
      "docs": ["https://openrouter.ai/docs/api/reference/overview", "https://openrouter.ai/docs/cookbook/video-generation/image-to-video",
