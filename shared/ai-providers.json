      "asOf": "2026-11-18",
      "terms": "OpenRouter passes each model's own provider terms through (openrouter.ai/terms).",
      "base": "https://openrouter.ai/api/v1",
      "auth": {"header": "Authorization", "scheme": "Bearer "},
      "chat": {"jsonMode": true, "extra": {"reasoning": {"effort": "low"}}},
      "upload": {"kind": "data_uri", "maxBytes": 20000000},
      "task": {"submit": {"method": "POST", "path": "/videos", "body": "{input}"}, "id": "id", "poll": "/videos/{id}", "status": "status",
               "done": ["completed"], "failed": ["failed", "cancelled", "expired"], "output": "unsigned_urls.0", "outputAuth": true,
               "error": "error", "cost": "usage.cost", "costUnit": "usd"},
      "check": {"method": "GET", "url": "https://openrouter.ai/api/v1/key"},
      "balance": {"url": "https://openrouter.ai/api/v1/key", "used": "data.usage", "limit": "data.limit", "left": "data.limit_remaining", "currencyIs": "USD",
                  "orElse": {"url": "https://openrouter.ai/api/v1/credits", "require": "data.total_credits", "limit": "data.total_credits",
                             "used": "data.total_usage", "leftFrom": ["data.total_credits", "data.total_usage"]}},
      "priceApi": "openrouter",
      "freeModels": ["llm", "vision"],
      "models": {
