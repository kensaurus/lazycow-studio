{
  "_about": "The AI provider registry (py/studio/providers/registry.py, docs/ai-api.md). Capabilities are a closed list; text-to-video is never registered, and every img2video model takes the real still. labelRequired belongs to the capability. Every model needs a commercial licence; risk 'unofficial' is never a default. Every provider names the official docs its entry was checked against (docs) and the day (asOf). Prices are list prices with their source and date; a live price API wins where the provider has one. A model may speak another protocol than its provider's chat (protocol). _rejected lists what was looked at and left out, with the reason.",
  "version": 1,
  "asOf": "2026-11-18",
  "_rejected": {
    "minimax music": "MiniMax closed its paid Music Generation API to new users on 2026-08-20 (platform.minimax.io/docs/guides/music-generation, read 2026-11-18).",
    "gemini video (Veo)": "Veo 3.1 Preview in the Gemini API was shut down on 2026-10-22, and Gemini Omni Flash video is not on the OpenAI-compatible endpoint (ai.google.dev/gemini-api/docs/video and /openai, read 2026-11-18). Image-conditioned Omni Flash and Veo are reachable through OpenRouter's /videos, but were not added: their licence passes through OpenRouter unverified here.",
    "piapi music (Suno, Udio)": "PiAPI sunset its Suno API (piapi.ai/docs/sunsetting-suno) and its Udio song API runs on its own pool of consumer accounts (piapi.ai/docs/overview, Pay-as-you-go): no commercial licence for the music.",
    "together vision on video": "Together's video understanding runs only on a dedicated endpoint (docs.together.ai/docs/inference/vision/inputs); its serverless vision model answers the picture questions (still frames) only.",
    "stability image-to-video": "Stability's API lists image, 3D and audio services only, no video (docs.stability.ai/llms.txt, read 2026-11-18).",
    "luma price": "Luma bills Ray 3.2 in credits (100 per 5 s at 720p) and the dollar value of a credit depends on the account's plan (docs.agents.lumalabs.ai/guides/pricing): no list price, so enter yours in Settings › AI before it runs.",
    "openrouter tts voices": "OpenRouter's speech models take only their preset voices (e.g. ElevenLabs v3: sarah, alice …; MiniMax Speech 2.8 lists English voices only), so only ElevenLabs v3 is registered there for Japanese lines."
  },
  "staleDays": 90,
  "capabilities": {
    "voice": {"labelRequired": true, "deadline": 600, "output": "mp3, mono, 44.1 kHz", "what": "a voice reads the reel's approved words"},
    "music": {"labelRequired": false, "deadline": 900, "output": "wav, trimmed to length", "what": "instrumental music made for the reel"},
    "sfx": {"labelRequired": false, "deadline": 600, "output": "m4a", "what": "natural sound for shots that have none"},
    "upscale": {"labelRequired": false, "deadline": 1800, "output": "H.264 mp4 with the clip's own sound", "what": "sharpens and upscales soft clips"},
    "slowmo": {"labelRequired": false, "deadline": 1200, "output": "mp4", "what": "smooth slow motion from the real frames"},
    "img2video": {"labelRequired": true, "deadline": 1200, "output": "9:16 mp4", "what": "a real still gets a slow camera move"},
    "bg-cut": {"labelRequired": false, "deadline": 1200, "output": "VP9 webm with alpha", "what": "the subject of a shot cut out of its own picture"},
    "llm": {"labelRequired": false, "deadline": 300, "output": "text", "what": "writing help (suggested lines, post angles)"},
    "vision": {"labelRequired": false, "deadline": 300, "output": "JSON", "what": "a model that looks at the reel and suggests fixes"}
  },
  "tools": {
    "review": {"capability": "vision", "what": "watches the rendered reel and suggests fixes (nothing is applied)"},
    "slowmo": {"capability": "slowmo", "what": "smooth slow motion on chosen shots (new in-between frames from the real ones)"},
    "sharpen": {"capability": "upscale", "what": "sharpens and upscales soft or low-resolution clips"},
    "music": {"capability": "music", "what": "instrumental music made for this reel from its mood and tempo"},
    "voice": {"capability": "voice", "what": "a Japanese AI voice reads the reel's approved words"},
    "living": {"capability": "img2video", "what": "a real still gets a slow camera move (nothing added)"},
    "foley": {"capability": "sfx", "what": "natural sound (wind, fire, steps, water) made from the picture of shots that have none"},
    "behind": {"capability": "bg-cut", "what": "the headline sits behind the subject of the opening shot (a cut-out of the shot's own picture)"}
  },
  "providers": {
