{
  "_about": "The AI provider registry (py/studio/providers/registry.py, docs/ai-api.md). Capabilities are a closed list; text-to-video is never registered. labelRequired belongs to the capability. Every model needs a commercial licence; risk 'unofficial' is never a default. Prices are list prices with their source and date; a live price API wins where the provider has one.",
  "version": 1,
  "asOf": "2026-11-17",
  "staleDays": 90,
  "capabilities": {
    "voice": {"labelRequired": true, "deadline": 600, "output": "mp3, mono, 44.1 kHz", "what": "a voice reads the reel's approved words"},
    "music": {"labelRequired": false, "deadline": 900, "output": "wav, trimmed to length", "what": "instrumental music made for the reel"},
    "sfx": {"labelRequired": false, "deadline": 600, "output": "m4a", "what": "natural sound for shots that have none"},
    "upscale": {"labelRequired": false, "deadline": 1800, "output": "H.264 mp4 with the clip's own sound", "what": "sharpens and upscales soft clips"},
    "slowmo": {"labelRequired": false, "deadline": 1200, "output": "mp4", "what": "smooth slow motion from the real frames"},
    "img2video": {"labelRequired": true, "deadline": 1200, "output": "9:16 mp4", "what": "a real still gets a slow camera move"},
    "bg-cut": {"labelRequired": false, "deadline": 1200, "output": "VP9 webm with alpha", "what": "the subject of a shot cut out of its own picture"},
    "llm": {"labelRequired": false, "deadline": 300, "output": "text", "what": "writing help (suggested lines, post angles)"},
    "vision": {"labelRequired": false, "deadline": 300, "output": "JSON", "what": "a model that looks at the reel and suggests fixes"}
  },
  "tools": {
    "review": {"capability": "vision", "what": "watches the rendered reel and suggests fixes (nothing is applied)"},
    "slowmo": {"capability": "slowmo", "what": "smooth slow motion on chosen shots (new in-between frames from the real ones)"},
    "sharpen": {"capability": "upscale", "what": "sharpens and upscales soft or low-resolution clips"},
    "music": {"capability": "music", "what": "instrumental music made for this reel from its mood and tempo"},
    "voice": {"capability": "voice", "what": "a Japanese AI voice reads the reel's approved words"},
    "living": {"capability": "img2video", "what": "a real still gets a slow camera move (nothing added)"},
    "foley": {"capability": "sfx", "what": "natural sound (wind, fire, steps, water) made from the picture of shots that have none"},
    "behind": {"capability": "bg-cut", "what": "the headline sits behind the subject of the opening shot (a cut-out of the shot's own picture)"}
  },
  "providers": {
    "fal": {
      "name": "fal.ai",
      "protocol": "fal_queue",
      "core": true,
      "keyEnv": "FAL_KEY",
      "keyHint": "fal.ai/dashboard/keys",
      "dashboard": "https://fal.ai/dashboard/billing",
      "base": "https://queue.fal.run",
      "auth": {"header": "Authorization", "scheme": "Key "},
      "check": {"method": "GET", "url": "https://api.fal.ai/v1/models/pricing?endpoint_id=fal-ai/rife/video"},
      "balance": {"url": "https://api.fal.ai/v1/account/billing?expand=credits", "require": "credits", "left": "credits.current_balance",
                  "currency": "credits.currency", "denied": "This key cannot read the balance (fal needs a key with billing read access). The dashboard shows it."},
      "priceApi": "fal",
      "upload": {"kind": "fal_storage", "token": "https://rest.fal.ai/storage/auth/token?storage_type=fal-cdn-v3"},
      "licenceCheck": {"url": "https://api.fal.ai/v1/models?endpoint_id={model}", "field": "models.0.metadata.license_type", "ok": ["commercial"], "auth": false},
      "models": {
        "fal-ai/rife/video": {
          "capability": "slowmo", "default": true, "label": "RIFE frame interpolation", "licence": "commercial",
          "price": {"usd": 0.0013, "unit": "seconds", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "files": {"video_url": "video"},
          "input": {"video_url": "{video_url}", "num_frames": 1, "use_calculated_fps": true, "use_scene_detection": false, "loop": false},
          "output": "video.url", "maxShort": 1080
        },
        "fal-ai/film/video": {
          "capability": "slowmo", "label": "FILM frame interpolation", "licence": "commercial",
          "price": {"usd": 0.0013, "unit": "seconds", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "files": {"video_url": "video"},
          "input": {"video_url": "{video_url}", "num_frames": 1, "use_calculated_fps": true, "use_scene_detection": false, "loop": false},
          "output": "video.url", "maxShort": 1080
        },
        "topaz/upscale/video/precision": {
          "capability": "upscale", "default": true, "label": "Topaz Upscale Video Precision (Proteus)", "licence": "commercial",
          "note": "Replaces fal-ai/topaz/upscale/video, which fal's catalogue search no longer lists (checked 2026-11-17).",
          "price": {"usd": 0.01, "unit": "units", "source": "fal pricing API read", "asOf": "2026-11-17"},
          "unitsPerSecond": 2,
          "unitNote": "A unit is a second of 720p output at 30 fps: 1080p is 2 a second, 4K 6 ($0.20 per 10 s at 1080p; fal.ai/models/topaz/upscale/video/precision, 2026-11-17).",
          "files": {"video_url": "video"},
          "input": {"video_url": "{video_url}", "upscale_factor": "{upscale_factor}", "model": "Proteus", "H264_output": true},
          "output": "video.url"
        },
        "fal-ai/seedvr/upscale/video": {
          "capability": "upscale", "label": "SeedVR2 video upscale", "licence": "commercial",
          "price": {"usd": 0.001, "unit": "megapixels", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "files": {"video_url": "video"},
          "input": {"video_url": "{video_url}", "upscale_factor": "{upscale_factor}"},
          "output": "video.url"
        },
        "fal-ai/stable-audio-25/text-to-audio": {
          "capability": "music", "default": true, "label": "Stable Audio 2.5", "licence": "commercial",
          "credit": "Stable Audio 2.5", "maker": "Stability AI", "page": "https://fal.ai/models/fal-ai/stable-audio-25/text-to-audio",
          "price": {"usd": 0.2, "unit": "audios", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "input": {"prompt": "{prompt}", "seconds_total": "{seconds:int}", "num_inference_steps": 8},
          "output": "audio.url", "conforms": true, "maxSeconds": 190
        },
        "fal-ai/minimax/speech-02-hd": {
          "capability": "voice", "default": true, "label": "MiniMax Speech-02 HD", "licence": "commercial",
          "price": {"usd": 0.1, "unit": "1000 characters", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "voiceDefault": "Japanese_CalmLady",
          "input": {"text": "{text}", "voice_setting": {"voice_id": "{voice}", "speed": 1.1, "vol": 1.0, "pitch": 0},
                    "language_boost": "Japanese", "output_format": "url",
                    "audio_setting": {"format": "mp3", "sample_rate": 44100, "bitrate": 128000, "channel": 1}},
          "output": "audio.url", "durationMs": "duration_ms", "conforms": true
        },
        "fal-ai/kling-video/v2.5-turbo/pro/image-to-video": {
          "capability": "img2video", "default": true, "label": "Kling 2.5 Turbo Pro image-to-video", "licence": "commercial",
          "price": {"usd": 0.07, "unit": "seconds", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "files": {"image_url": "image"},
          "input": {"image_url": "{image_url}", "prompt": "{prompt}", "negative_prompt": "{negative_prompt}", "duration": "{seconds:str}", "cfg_scale": 0.5},
          "output": "video.url", "conforms": true
        },
        "fal-ai/mmaudio-v2": {
          "capability": "sfx", "default": true, "label": "MMAudio V2 (sound from the picture)", "licence": "commercial",
          "credit": "MMAudio V2",
          "price": {"usd": 0.001, "unit": "seconds", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "files": {"video_url": "video"},
          "input": {"video_url": "{video_url}", "prompt": "{prompt}", "negative_prompt": "{negative_prompt}", "duration": "{seconds}", "num_steps": 25, "cfg_strength": 4.5},
          "output": "video.url", "fromPicture": true
        },
        "fal-ai/birefnet/v2/video": {
          "capability": "bg-cut", "default": true, "label": "BiRefNet v2 video", "licence": "commercial",
          "price": {"usd": 0.000575, "unit": "compute seconds", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "files": {"video_url": "video"},
          "input": {"video_url": "{video_url}", "model": "General Use (Light)", "operating_resolution": "1024x1024", "refine_foreground": true,
                    "output_mask": true, "video_output_type": "X264 (.mp4)", "video_quality": "high"},
          "output": "mask_video.url", "outputKind": "mask"
        },
        "fal-ai/elevenlabs/tts/eleven-v3": {
          "capability": "voice", "label": "ElevenLabs v3 (through fal)", "licence": "commercial",
          "price": {"usd": 0.1, "unit": "1000 characters", "source": "fal pricing measured", "asOf": "2026-11-09"},
          "voiceDefault": "Rachel",
          "input": {"text": "{text}", "voice": "{voice}", "language_code": "ja", "output_format": "mp3_44100_128"},
          "output": "audio.url"
        }
      }
    },
