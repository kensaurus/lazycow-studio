{
  "name": "lazycow-studio",
  "private": true,
  "version": "0.14.0",
  "description": "Turn your own footage into short vertical videos (Reels, Shorts, TikTok) on your own computer: auto-picked clips, beat cuts, approved words, CC0 music, review and scheduling.",
  "author": "Kenji Sakuramoto (https://kensaur.us)",
  "contributors": [
    "kensaurus LLC (https://kensaur.us)"
  ],
  "homepage": "https://kensaur.us",
  "funding": {
    "type": "individual",
    "url": "https://github.com/kensaurus/lazycow-studio/blob/main/SUPPORTING.md"
  },
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "review": "node server/review.mjs",
    "setup": "node scripts/setup.mjs",
    "app": "node scripts/app.mjs",
    "holidays": "python scripts/holidays.py",
    "mcp": "node server/mcp.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p .",
    "props": "node scripts/prepare-props.mjs"
  },
  "dependencies": {
    "@remotion/captions": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/motion-blur": "4.0.543",
    "budoux": "^0.10.1",
    "playwright-core": "1.64.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543",
    "zod": "4.6.7"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "topojson-client": "3.1.0",
    "typescript": "^5.7.0",
    "world-atlas": "2.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kensaurus/lazycow-studio.git"
  },
  "keywords": [
    "reels",
    "shorts",
    "tiktok",
    "video-editor",
    "remotion",
    "ffmpeg",
    "clip",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  }
}
